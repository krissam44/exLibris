<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette reprise TELLE QUELLE de Lirevia (MainLayout.razor.cs,
        PaletteLight). Les valeurs sont recopiées à la main parce que les deux
        applications ne partagent aucun code d'interface — l'une est du CSS
        MudBlazor, l'autre du XAML.

        ⚠️ C'est donc une DUPLICATION assumée : si la charte de Lirevia change,
        ce fichier ne le saura pas. Il est le seul endroit à corriger ici, et
        c'est la raison pour laquelle aucune couleur n'est écrite ailleurs dans
        l'application — un « #5478a5 » posé au fil d'un contrôle serait
        introuvable le jour venu.
    -->

    <!-- Bleu ardoise : barre du haut, pied de page, en-têtes de dialogue. -->
    <Color x:Key="ArdoiseColor">#5478A5</Color>
    <!-- Orange : accents, libellés secondaires, valeurs à remarquer. -->
    <Color x:Key="OrangeColor">#E8913A</Color>
    <!-- Vert Chriss Consulting, conservé pour les confirmations. -->
    <Color x:Key="VertColor">#3A786D</Color>

    <Color x:Key="FondColor">#F5F5F0</Color>          <!-- fond général -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>       <!-- cartes, grilles -->
    <Color x:Key="MenuColor">#FAFAF8</Color>          <!-- barre latérale -->
    <Color x:Key="TexteColor">#1A1A1A</Color>
    <Color x:Key="TexteDouxColor">#5C5C5C</Color>
    <Color x:Key="TraitColor">#DEE2E6</Color>
    <Color x:Key="RougeColor">#DB0016</Color>         <!-- même rouge que les boutons Fermer de Lirevia -->

    <SolidColorBrush x:Key="Ardoise"    Color="{StaticResource ArdoiseColor}" />
    <SolidColorBrush x:Key="Orange"     Color="{StaticResource OrangeColor}" />
    <SolidColorBrush x:Key="Vert"       Color="{StaticResource VertColor}" />
    <SolidColorBrush x:Key="Fond"       Color="{StaticResource FondColor}" />
    <SolidColorBrush x:Key="Surface"    Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="FondMenu"   Color="{StaticResource MenuColor}" />
    <SolidColorBrush x:Key="Texte"      Color="{StaticResource TexteColor}" />
    <SolidColorBrush x:Key="TexteDoux"  Color="{StaticResource TexteDouxColor}" />
    <SolidColorBrush x:Key="Trait"      Color="{StaticResource TraitColor}" />
    <SolidColorBrush x:Key="Rouge"      Color="{StaticResource RougeColor}" />
    <SolidColorBrush x:Key="TexteBarre" Color="#FFFFFF" />

    <!-- Survol et sélection du menu : l'ardoise très diluée, pour que l'élément
         actif se voie sans crier. -->
    <SolidColorBrush x:Key="MenuSurvol"   Color="{StaticResource ArdoiseColor}" Opacity="0.10" />
    <SolidColorBrush x:Key="MenuActifFond" Color="{StaticResource ArdoiseColor}" Opacity="0.16" />

</ResourceDictionary>
