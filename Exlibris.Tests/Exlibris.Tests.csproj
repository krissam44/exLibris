  <!-- Le formulaire d'ouvrage, repris PAR LIEN comme dans Exlibris.Photino :
       il n'a plus aucune dépendance WPF depuis le passage des dialogues en
       asynchrone, donc il s'éprouve ici sans projet d'interface. C'est par lui
       que passait la perte des champs non affichés (voir LivreFormulaireTests). -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="..\Exlibris\ViewModels\LivreFormulaireViewModel.cs" Link="Liens\LivreFormulaireViewModel.cs" />
    <Compile Include="..\Exlibris\Services\IDialogueService.cs" Link="Liens\IDialogueService.cs" />
