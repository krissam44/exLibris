@* Emplacement d'une rubrique pas encore portée. Disparaît rubrique par
   rubrique au fil des étapes du portage. *@

<MudPaper Elevation="1" Class="carte">
    <div class="titre-carte">@Titre</div>
    <div class="aide">
        Cette rubrique n'est pas encore portée dans la version Photino
        (étape @Etape du portage). Elle reste disponible dans la version WPF.
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Titre { get; set; } = "";
    [Parameter, EditorRequired] public int Etape { get; set; }
}
