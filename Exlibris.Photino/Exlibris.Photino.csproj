<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Ex-libris en Photino.Blazor : la même application que le projet WPF,
       mais pour Windows ET Linux. Les deux interfaces partagent Exlibris.Data
       et Exlibris.Shared, donc la même base et les mêmes règles. -->

  <PropertyGroup>
    <!-- Thème Syncfusion réellement chargé par wwwroot/index.html. Les autres
         sont écartés de la publication par la cible ElaguerThemesSyncfusion,
         plus bas. À changer AUX DEUX endroits si l'on adopte un autre thème. -->
    <ThemeSyncfusion>bootstrap5.css</ThemeSyncfusion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- WinExe évite la console sous Windows ; ignoré sous Linux. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Exlibris.Photino</RootNamespace>
    <AssemblyName>Exlibris</AssemblyName>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <ApplicationIcon>Assets\exlibris.ico</ApplicationIcon>

    <!-- Numérotation PROPRE à la version Photino depuis le 04/10/2026 (0.2.1
         était celui du WPF au moment du portage). L'installateur la lit dans
         l'exécutable : c'est le seul endroit où l'incrémenter. -->
    <Version>0.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Exlibris.Data\Exlibris.Data.csproj" />
    <ProjectReference Include="..\Exlibris.Shared\Exlibris.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PhotinoX.Blazor, le fork maintenu de Photino.Blazor (dernière version
         4.0.13 de janvier 2025, .NET 8/9 seulement) : il cible .NET 10, tire
         lui-même la bonne WebView, et sous Linux se contente de glibc 2.34.
         Même socle que Budgevia, Locavia et Prospevia (passage le 15/10/2026). -->
    <PackageReference Include="PhotinoX.Blazor" Version="5.3.4" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <!-- Même version que Syncfusion WPF, pour que la même clé de licence vaille. -->
    <PackageReference Include="Syncfusion.Blazor.Grid" Version="34.2.5" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="34.2.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <!-- Les ViewModels (ViewModels\) et IDialogueService viennent du projet WPF,
       supprimé le 12/11/2026 : Photino est désormais la seule interface. Leur
       espace de noms (Exlibris.ViewModels, Exlibris.Services) est conservé tel
       quel, pour ne pas toucher cinquante fichiers sans rien y gagner.

       La configuration : appsettings.json (versionné, valeurs vides) et
       appsettings.Local.json (la vraie clé, non versionné). -->
  <ItemGroup>
    <!-- ⚠️ Retirés d'abord des éléments que le SDK Razor pose d'office : il range
         tout .json du projet en Content, copié quoi qu'il arrive, et la
         condition ci-dessous n'aurait rien empêché — la clé partait avec une
         publication « -Release » (constaté le 12/11/2026, rattrapé alors par
         la vérification de publier-photino.ps1). -->
    <Content Remove="appsettings*.json" />
    <None Remove="appsettings*.json" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- SansReglagesLocaux=true (publier-photino.ps1 -Release) : une publication
         destinée au public n'emporte JAMAIS la clé Syncfusion ni l'adresse Lirevia. -->
    <None Include="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('appsettings.Local.json') And '$(SansReglagesLocaux)' != 'true'" />
    <None Update="Assets\exlibris-256.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\exlibris.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Installation Linux : lanceur .desktop et scripts, déposés à la RACINE de
       la publication et seulement pour une cible linux-*. L'icône du lanceur
       est Assets/exlibris-256.png, déjà publiée pour la fenêtre. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <None Include="linux\*" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ===================================================================
       Élagage des thèmes Syncfusion à la publication
       ===================================================================
       Repris de Lirevia via le POC Photino. Syncfusion.Blazor.Themes livre
       des dizaines de thèmes (plus de 200 Mo) pour un seul chargé.

       Ne s'exécute QUE sur `dotnet publish` : en développement, tous les
       thèmes restent disponibles pour en essayer un autre.

       Différence avec Lirevia : on ne garde PAS les variantes .br/.gz. Elles
       servent à la négociation de contenu de Kestrel ; Photino lit wwwroot sur
       le disque et ne sert jamais que le fichier brut.
       =================================================================== -->
  <Target Name="ElaguerThemesSyncfusion" AfterTargets="Publish">
    <PropertyGroup>
      <DossierThemes>$(PublishDir)wwwroot/_content/Syncfusion.Blazor.Themes/</DossierThemes>
    </PropertyGroup>
    <ItemGroup>
      <ThemesPublies    Include="$(DossierThemes)**/*.*" />
      <ThemesAGarder    Include="$(DossierThemes)$(ThemeSyncfusion)" />
      <ThemesASupprimer Include="@(ThemesPublies)" Exclude="@(ThemesAGarder)" />
    </ItemGroup>
    <Delete Files="@(ThemesASupprimer)" />
    <RemoveDir Directories="$(DossierThemes)customized" ContinueOnError="true" />
    <Message Importance="high"
             Text="Thèmes Syncfusion : @(ThemesASupprimer->Count()) fichiers écartés, @(ThemesAGarder->Count()) conservé ($(ThemeSyncfusion))." />
  </Target>

</Project>
