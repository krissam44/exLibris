<Project Sdk="Microsoft.NET.Sdk">

	<!-- ================================================================
	     La signature Android.

	     Chemin du magasin, alias et mots de passe vivent dans un fichier
	     LOCAL jamais versionné — même convention que la clé de licence
	     Syncfusion et appsettings.Local.json. Modèle et mode d'emploi :
	     signature.example.props.

	     L'import est CONDITIONNEL : sans ce fichier le projet se compile, se
	     déploie sur un téléphone branché et se débogue normalement. Seule la
	     publication d'un APK distribuable en a besoin, et
	     publier-scanner.ps1 le dit clairement quand il manque.
	     ================================================================ -->
	<Import Project="$(MSBuildThisFileDirectory)signature.props"
	        Condition="Exists('$(MSBuildThisFileDirectory)signature.props')" />

	<PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(AndroidSigningKeyStore)' != ''">
		<AndroidKeyStore>true</AndroidKeyStore>

		<!-- ⚠️ apk, ET NON aab — qui est le défaut du SDK en Release.
		     Un .aab est le format du Play Store : aucun téléphone ne sait
		     l'installer. Sans cette ligne la publication réussit et produit
		     un fichier que le destinataire ne peut pas ouvrir, sans que rien
		     ne signale l'erreur. Pour déposer un jour sur le Play Store :
		     -p:AndroidPackageFormat=aab en ligne de commande. -->
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Exlibris.Scanner</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Ex-libris Scanner</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>fr.sammut.exlibris.scanner</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>8</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- ⚠️ « Include » EST LA COUCHE DE FOND, PAS L'ICÔNE COMPLÈTE.
		     C'est le contresens qui a produit une icône DOUBLÉE le 30/08/2026 :
		     le logo y figurait à la fois en fond (grand, rogné par le masque) et
		     en avant-plan (plus petit, posé dessus). Vérifié en composant à la
		     main les deux couches qu'engendre le SDK.

		     Android superpose trois choses : Color, puis Include, puis
		     ForegroundFile — et découpe le tout au masque du lanceur, rond sur
		     certains téléphones, en goutte ou en écusson sur d'autres.

		     appicon.png est donc un CARRÉ UNI de #F4F6F8, comme l'appicon.svg du
		     modèle MAUI qui n'est qu'un rectangle de couleur. À refaire ainsi :

		         $b = New-Object System.Drawing.Bitmap(1024, 1024,
		                  [System.Drawing.Imaging.PixelFormat]::Format32bppArgb)
		         $g = [System.Drawing.Graphics]::FromImage($b)
		         $g.Clear([System.Drawing.ColorTranslator]::FromHtml('#F4F6F8'))
		         $b.Save('Resources\AppIcon\appicon.png')

		     appiconfg.png porte la marque, et elle seule. Produite par
		     installateur\faire-logo.ps1 — seule source des icônes des DEUX
		     applications, sans quoi l'une porterait un jour une feuille d'un
		     autre vert :

		         faire-logo.ps1 -Destination ...\appiconfg.png -Remplissage 0.58

		     0,58 et non 0,86 : le masque rogne les bords, et une marque qui
		     remplit le carré s'y retrouve amputée de ses angles.

		     Color est repris comme fond de tuile — un blanc cassé plutôt que du
		     blanc pur, pour que l'icône se détache d'un fond d'écran clair. -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#F4F6F8" />

		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#F4F6F8" BaseSize="180,180" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Le MÊME lecteur de code-barres que Lirevia.Mobile, à la MÊME version.
		     Ce n'est pas de la coquetterie : ce couple version de MAUI / version du
		     scanner est le seul qu'on ait vu marcher sur un téléphone réel, et les
		     bibliothèques de caméra sont précisément celles qui se compilent très
		     bien et refusent de s'ouvrir sur l'appareil. -->
		<PackageReference Include="BarcodeScanning.Native.Maui" Version="3.1.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- Le format du fichier d'inventaire vient d'Exlibris.Shared, et n'est
		     PAS recopié ici. Le téléphone et le poste se déploient séparément :
		     deux définitions du même format finiraient par diverger, et le
		     désaccord ne se verrait pas à l'import — il produirait des rangements
		     tronqués, découverts des semaines plus tard devant une étagère. -->
		<ProjectReference Include="..\Exlibris.Shared\Exlibris.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

</Project>
